%% Tarea3-MarioRedondo

%Creamos una función para que sea más util y poder cambiar algunos
%parametros
function simular_bicicleta(m, Cd, dt, t_final)
%% PARAMETROS
%Parametros de entrada
% Cd = Coeficiente de arrastre
% m = Masa original (kg)
% dt = Diferencial de tiempo
% t_final = Tiempo total transcurrido (s)

% Parámetros del vehículo
I = 2000; % Inercia (kg*m^2)
L = 2.5; % Longitud entre ejes (m)
A = 2.2; % Área frontal (m^2)
g = 9.81; % Gravedad (m/s^2)

% Parámetros de movimiento
throttle = @(t) min(1, max(0, 0.1*t)); % Aceleración
brake = @(t) 0; % Sin frenado
delta = @(t) min(pi/6, max(-pi/6, 0.1 * sin(0.1*t))); % Dirección

%Creamos unos parametros de simulación
t = 0:dt:t_final; %Vector tiempo ej: [0.1, 0.2,...,50]
n = length(t);

%Creamos unas condiciones iniciales
x = zeros(1, n);
y = zeros(1, n);
v = zeros(1, n);
theta = zeros(1 ,n); %Angulo de orientación (rad)

%% SIMULACIÓN
%Creamos una simulación
for i = 1:n-1
    %Calculamos fuerza de movimiento. 2ºLey_Newton: F=m*a
    F_throttle = m * throttle(t(i)) ;
    %Calculamos la fuerza que haría el aire
    %Nos vamos a inventar una variable que se llamará p
    p = 1.225; % Densidad del aire (kg/m^3)
    F_drag = 0.5 * p * Cd * A * v(i)^2;

    % Calculamos la aceleración
    a = (F_throttle - F_drag) / m;

    % Actualizamos la velocidad y la posición
    v(i+1) = v(i) + a * dt;
    theta(i+1) = theta(i) + delta(t(i)) * dt;
    % X = posición entre derecha e izquierda
    x(i+1) = x(i) + v(i) * cos(theta(i)) * dt;
    % Y = posición de avance o retroceso
    y(i+1) = y(i) + v(i) * sin(theta(i)) * dt;
end

%%GRÁFICA
figure;

%Gráfica de posición X
subplot(1,3,1);
plot(t, x, 'b', 'LineWidth', 2);
xlabel('t (s)');
ylabel('X (m)');
title('Trayectoria X');
grid on;

%Gráfica posición y
subplot (1,3,2);
plot(t, y, 'g', 'LineWidth', 2);
xlabel('t (s)');
ylabel('Y (m)');
title('Trayectoria Y');
grid on;

%Gráfica de velocidad
subplot(1,3,3);
plot(t, v, 'r', 'LineWidth', 2);
xlabel('Tiempo (s)');
ylabel('Velocidad (m/s)');
title('Velocidad');
grid on;

end

simular_bicicleta(1200, 0.3, 0.1, 50);